# Self-hosting settings for docker-compose.selfhost.yml.
# Copy to `.env` in the repository root (gitignored) and fill in the blanks.
# Generate each secret with:  openssl rand -hex 32

# Postgres password (letters and digits only: it is used inside a URL).
POSTGRES_PASSWORD=

# Signs session cookies and one-time sign-in / reset links. Required.
JWT_SECRET=
# Signs client intake edit links. Required.
INTAKE_SECRET=

# The public HTTPS address of this server (emailed links, Stripe redirects, CORS).
CLIENT_URL=https://platebook.example.com

# Reverse proxies in front of the app that append to X-Forwarded-For.
# 1 = one proxy (Caddy or nginx, as in docs/SELF_HOSTING.md); 0 = no proxy.
TRUST_PROXY_HOPS=1

# Who may create an account: open | first (only the first account) | closed.
SIGNUP_MODE=first

# SMTP. Leave EMAIL_HOST empty to log messages instead of sending them.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Platebook <noreply@example.com>

# Payments: disabled | manual (default) | stripe. Stripe needs both keys.
PAYMENTS_MODE=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI: each chef sets their own provider and key in Settings -> AI Assistant.
# Optional shared Claude key for accounts that haven't (billed to you).
ANTHROPIC_API_KEY=
# true = chefs may point a Custom AI provider at private or plain-HTTP
# addresses (e.g. Ollama on this network). Leave off on a shared server.
AI_ALLOW_PRIVATE_URLS=

# Daily pg_dump into the `backups` volume (keeps 30), at this local hour.
AUTO_BACKUP=true
AUTO_BACKUP_HOUR=3
