# Copy to server-rs/.env (gitignored), or run `npm run db:setup` at the repository root.
# Names match the old Express server's server/.env where they overlap.
DATABASE_URL=postgres://postgres@localhost:5432/chef_dev
PORT=3002
# NODE_ENV=production hides internal error details and requires JWT_SECRET.
NODE_ENV=development
# Must equal the Node server's JWT_SECRET so existing session cookies keep working.
JWT_SECRET=dev-secret-change-me
CLIENT_URL=http://localhost:5174
# Must equal the Node server's INTAKE_SECRET so emailed intake edit links keep working.
# Required with NODE_ENV=production.
INTAKE_SECRET=chef-app-intake-secret-change-me

# Who may create an account: open (default) | first (only the first account) | closed.
SIGNUP_MODE=open

# SMTP. With EMAIL_HOST/USER/PASS empty nothing is sent: messages are logged (dev).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# ALLOW_DEV_LINK=true echoes magic/reset links in the API response (dev only).
ALLOW_DEV_LINK=false

# Payments: disabled | manual (default) | stripe. Stripe needs both keys.
PAYMENTS_MODE=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Deposit used only when an account has no deposit_cents setting.
BOOKING_FEE_CENTS=5000

# Claude (recipe text import, menu suggestions). Empty = AI features off.
ANTHROPIC_API_KEY=
# Overrides the per-route defaults (claude-sonnet-5-5; claude-haiku-5-5 for the test ping).
ANTHROPIC_MODEL=

# Serve the React build (production sets ../client/dist by default).
# CLIENT_DIST=../client/dist

# Optional daily pg_dump (Railway Postgres has its own backups; off by default).
AUTO_BACKUP=false
BACKUP_DIR=backups
AUTO_BACKUP_HOUR=3

RUST_LOG=info,tower_http=info
